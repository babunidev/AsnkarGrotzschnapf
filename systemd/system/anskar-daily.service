[Unit]
Description=Anskar Grotzschnapf daily generate and publish (system wake)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Run the unit as root so systemd-inhibit can block sleep without polkit
# interactive auth. Drop to @USER@ for the artist (never paint as root).
WorkingDirectory=@PROJECT_ROOT@
Environment=ANSKAR_SCHEDULED=1
ExecStart=/usr/bin/systemd-inhibit --what=idle:sleep:handle-lid-switch --who=AnskarGrotzschnapf --why="Daily artwork production" --mode=block /usr/bin/runuser -u @USER@ -- env HOME=@HOME@ USER=@USER@ PYTHONPATH=@PROJECT_ROOT@/src XDG_RUNTIME_DIR=/run/user/@UID@ DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@UID@/bus ANSKAR_SCHEDULED=1 ANSKAR_NOTIFY=1 @PYTHON@ -m anskar daily-run
Nice=10

[Install]
WantedBy=multi-user.target
